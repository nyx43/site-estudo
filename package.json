{
  "name": "plataforma-estudos-es",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:lan": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:backup:verify": "tsx scripts/backup-db.ts --verify-restore",
    "content:validate": "tsx scripts/validate-curriculum.ts",
    "check": "npm run content:validate && npm run lint && npm run typecheck && npm test && npm run test:db && npm run build",
    "test:e2e": "playwright test",
    "verify:examples": "tsx scripts/verify-examples.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
