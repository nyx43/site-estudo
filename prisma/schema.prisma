generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Subject {
  id          String   @id
  slug        String   @unique
  name        String
  description String
  category    String
  accent      String
  orderIndex  Int
  version     Int
  learningOutcomes Json
  modules     Module[]
}

model Module {
  id          String  @id
  slug        String
  title       String
  description String
  orderIndex  Int
  project     Json
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topics      Topic[]

  @@unique([subjectId, slug])
  @@index([subjectId, orderIndex])
}

model Topic {
  id          String @id
  slug        String
  title       String
  summary     String
  orderIndex  Int
  moduleId    String
  module      Module @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  plan        Json

  @@unique([moduleId, slug])
  @@index([moduleId, orderIndex])
}
